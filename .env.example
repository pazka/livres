# livres — environment. Copy to livres.env (chmod 600), never commit the real file.
# The defaults below are the hosh.it box values: copying this file unchanged is enough, then the
# OWNER fills the secrets with scripts/set-secrets.sh (never the agent). `hosh-deploy register` checks
# the names on the `# required:` line are non-empty (values are never printed).
# required: LIVRES_ADMIN_PASSWORD_HASH LIVRES_ADMIN_TOKEN_SHA256 LIVRES_OWNER_EMAIL LIVRES_MAIL_FROM LIVRES_SMTP_HOST LIVRES_SMTP_PASSWORD

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/livres:v0.2.0'
APP_BIND='127.0.0.1:9133'

# --- app ---
# Behind Traefik: X-Forwarded-For is trustworthy only from the docker gateway / loopback.
APP_TRUSTED_PROXIES='127.0.0.0/8,::1/128,172.16.0.0/12'
APP_BASE_URL='https://livres.hosh.it'

# --- owner access (scripts/set-secrets.sh writes these) ---
# scrypt hash of the admin page password
LIVRES_ADMIN_PASSWORD_HASH=''
# sha256 of the agent/CI API token (the token itself goes to GitHub secret LIVRES_ADMIN_TOKEN)
LIVRES_ADMIN_TOKEN_SHA256=''
# optional comma-separated allowlist of Ma liseuse install tokens; empty = any install may send requests
LIVRES_CLIENT_TOKENS=''

# --- mail (book requests + source alerts go to the owner) ---
LIVRES_OWNER_EMAIL=''
LIVRES_MAIL_FROM=''
LIVRES_SMTP_HOST=''
LIVRES_SMTP_PORT='587'
LIVRES_SMTP_USER=''
LIVRES_SMTP_PASSWORD=''
# starttls (port 587) | ssl (port 465) | none
LIVRES_SMTP_TLS='starttls'

# --- behaviour (defaults are fine) ---
LIVRES_HEALTH_INTERVAL='21600'
LIVRES_HARVEST_INTERVAL='604800'
LIVRES_FAIL_THRESHOLD='2'
LIVRES_REQUESTS_PER_HOUR='5'
LIVRES_REQUESTS_PER_DAY='50'
LIVRES_MIN_HOST_INTERVAL='1'
LIVRES_CACHE_TTL='600'
